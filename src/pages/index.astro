</head>
  <body class="bg-zinc-950 text-white font-sans antialiased">
    
    <!-- BARRA DE NAVEGACIÓN -->
    <header class="fixed top-0 w-full bg-zinc-950/90 backdrop-blur-sm border-b border-zinc-800 z-50">
      <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="#inicio" class="enlace-nav text-2xl font-bold tracking-tighter">
          ENORA<span class="text-blue-500">.</span>
        </a>
        <nav class="hidden md:flex gap-8 font-medium text-zinc-300">
          <a href="#inicio" class="enlace-nav hover:text-white transition-colors">Inicio</a>
          <a href="#equipamiento" class="enlace-nav hover:text-white transition-colors">Servicios</a>
          <a href="#multimedia" class="enlace-nav hover:text-white transition-colors">Eventos</a>
          <a href="#contacto" class="enlace-nav hover:text-white transition-colors">Contacto</a>
          <a href="#ubicacion" class="enlace-nav hover:text-white transition-colors">Ubicación</a>
        </nav>
        <button id="btn-menu" class="md:hidden text-zinc-300 hover:text-white focus:outline-none" aria-label="Abrir menú">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      <nav id="menu-movil" class="hidden absolute top-20 left-0 w-full bg-zinc-950/95 backdrop-blur-md border-b border-zinc-800 flex-col items-center py-6 gap-6 font-medium text-zinc-300 md:hidden z-40">
        <a href="#inicio" class="enlace-nav enlace-movil hover:text-white text-lg">Inicio</a>
        <a href="#equipamiento" class="enlace-nav enlace-movil hover:text-white text-lg">Servicios</a>
        <a href="#multimedia" class="enlace-nav enlace-movil hover:text-white text-lg">Eventos</a>
        <a href="#contacto" class="enlace-nav enlace-movil hover:text-white text-lg">Contacto</a>
        <a href="#ubicacion" class="enlace-nav enlace-movil hover:text-white text-lg">Ubicación</a>
      </nav>
    </header>

    <!-- SECCIÓN: INICIO -->
    <section id="inicio" class="flex flex-col items-center justify-center min-h-screen text-center px-6 pt-20">
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
        ENORA <span class="text-blue-500">EVENTOS</span>
      </h1>
      <p class="text-lg md:text-2xl text-zinc-400 max-w-2xl mb-10">
        Alquiler de sonido e iluminación profesional en Mar del Plata y alrededores. Elevá tu evento con los mejores equipos.
      </p>
      <a href="#contacto" class="enlace-nav bg-white text-black font-semibold py-3 px-8 rounded-full hover:bg-gray-200 transition-colors duration-300">
        Solicitar Presupuesto
      </a>
    </section>

    <!-- SECCIÓN: SERVICIOS Y EQUIPAMIENTO -->
    <section id="equipamiento" class="min-h-[80vh] flex flex-col justify-center max-w-7xl mx-auto px-6 py-24 border-t border-zinc-900">
      <h2 class="text-3xl md:text-5xl font-bold mb-12 text-center md:text-left">Nuestros <span class="text-blue-500">Servicios</span></h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-zinc-900 p-8 rounded-2xl border border-zinc-800 hover:border-zinc-700 transition-colors">
          <h3 class="text-xl font-bold mb-4">Sonido Profesional</h3>
          <p class="text-zinc-400">Sistemas de audio de alta fidelidad, incluyendo altavoces JBL & AudioCenter + Subwoofers, garantizando potencia inmersiva.</p>
        </div>
        <div class="bg-zinc-900 p-8 rounded-2xl border border-zinc-800 hover:border-zinc-700 transition-colors">
          <h3 class="text-xl font-bold mb-4">Iluminación Inteligente</h3>
          <p class="text-zinc-400">Despliegue visual con luminarias DMX, equipos Tecshow y BigDipper para transformar por completo la atmósfera.</p>
        </div>
        <div class="bg-zinc-900 p-8 rounded-2xl border border-zinc-800 hover:border-zinc-700 transition-colors">
          <h3 class="text-xl font-bold mb-4">DJs Exclusivos</h3>
          <p class="text-zinc-400">DJs profesionales que tocan en los mejores boliches de Mar del Plata, asegurando la selección musical perfecta.</p>
        </div>
      </div>
    </section>

    <!-- SECCIÓN: MULTIMEDIA (CARRUSEL) -->
    <section id="multimedia" class="min-h-[80vh] flex flex-col justify-center max-w-6xl mx-auto px-6 py-24 border-t border-zinc-900">
      <h2 class="text-3xl md:text-5xl font-bold mb-12">Últimos <span class="text-blue-500">Eventos</span></h2>

      <div id="galeria-carrusel" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 min-h-[400px]">
        
        <!-- PÁGINA 1 -->
        <!-- 1. Video 3 -->
        <div class="item-carrusel hidden aspect-[4/5] bg-zinc-800 rounded-2xl flex-col items-center justify-center border border-zinc-700 overflow-hidden relative">
          <video autoplay loop muted playsinline preload="metadata" class="w-full h-full object-cover">
            <source src="/multimedia/video3.mp4" type="video/mp4" />
          </video>
        </div>

        <!-- 2. Imagen 2 -->
        <div class="item-carrusel hidden aspect-[4/5] bg-zinc-800 rounded-2xl flex-col items-center justify-center border border-zinc-700 overflow-hidden relative">
          <img src="/multimedia/imagen2.jpg" alt="Armado Enora Eventos" class="w-full h-full object-cover">
        </div>

        <!-- 3. Video 2 optimizado -->
        <div class="item-carrusel hidden aspect-[4/5] bg-zinc-800 rounded-2xl flex-col items-center justify-center border border-zinc-700 overflow-hidden relative">
          <video autoplay loop muted playsinline preload="metadata" class="w-full h-full object-cover">
            <source src="/multimedia/video2_opt.mp4" type="video/mp4" />
          </video>
        </div>

        <!-- PÁGINA 2 -->
        <!-- 4. Video 4 (Optimizado) -->
