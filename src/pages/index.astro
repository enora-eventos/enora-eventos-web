          <video autoplay loop muted playsinline preload="metadata" class="w-full h-full object-cover">
            <source src="/multimedia/video4_opt.mp4" type="video/mp4" />
          </video>
        </div>

        <!-- 5. Imagen 1 -->
        <div class="item-carrusel hidden aspect-[4/5] bg-zinc-800 rounded-2xl flex-col items-center justify-center border border-zinc-700 overflow-hidden relative">
          <img src="/multimedia/imagen1.jpg" alt="Armado Enora Eventos" class="w-full h-full object-cover">
        </div>

        <!-- 6. Video 1 -->
        <div class="item-carrusel hidden aspect-[4/5] bg-zinc-800 rounded-2xl flex-col items-center justify-center border border-zinc-700 overflow-hidden relative">
          <video autoplay loop muted playsinline preload="metadata" class="w-full h-full object-cover">
            <source src="/multimedia/video1_opt.mp4" type="video/mp4" />
          </video>
        </div>

      </div>

      <!-- Controles del Carrusel -->
      <div class="flex justify-center items-center gap-6 mt-12">
        <button id="btn-prev" class="bg-zinc-900 border border-zinc-700 hover:bg-zinc-800 text-white p-4 rounded-full transition-all hover:scale-105 active:scale-95 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <div id="indicador-pagina" class="text-zinc-400 font-medium tracking-widest text-sm">1 / 2</div>
        <button id="btn-next" class="bg-zinc-900 border border-zinc-700 hover:bg-zinc-800 text-white p-4 rounded-full transition-all hover:scale-105 active:scale-95 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </section>

    <!-- SECCIÓN: CONTACTO -->
    <section id="contacto" class="min-h-[60vh] flex flex-col justify-center max-w-6xl mx-auto px-6 py-24 border-t border-zinc-900">
      <h2 class="text-3xl md:text-5xl font-bold mb-8">Trabajemos <span class="text-blue-500">Juntos</span></h2>
      <p class="text-zinc-400 mb-8 max-w-xl">
        ¿Listo para llevar tu evento al siguiente nivel? Contáctanos por cualquiera de nuestros canales oficiales.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="https://wa.me/message/LE24NNC3HHRFB1" target="_blank" rel="noopener noreferrer" class="bg-green-600 hover:bg-green-500 text-white font-semibold py-4 px-8 rounded-xl text-center transition-colors">
          WhatsApp
        </a>
        <a href="https://www.instagram.com/enora.eventos?igsh=Y3BmNGlrODVwa3V3" target="_blank" rel="noopener noreferrer" class="bg-gradient-to-r from-purple-500 to-pink-500 hover:opacity-90 text-white font-semibold py-4 px-8 rounded-xl text-center transition-opacity">
          Instagram
        </a>
        <a href="mailto:contacto@enoraeventos.com.ar" class="bg-zinc-800 hover:bg-zinc-700 text-white font-semibold py-4 px-8 rounded-xl text-center transition-colors border border-zinc-700">
          Correo Electrónico
        </a>
      </div>
    </section>

    <!-- SECCIÓN: UBICACIÓN -->
    <section id="ubicacion" class="min-h-[60vh] flex flex-col justify-center max-w-6xl mx-auto px-6 py-24 border-t border-zinc-900">
      <h2 class="text-3xl md:text-5xl font-bold mb-8">Nuestra <span class="text-blue-500">Cobertura</span></h2>
      <p class="text-zinc-400 mb-10 max-w-2xl">
        Ubicados en Mar del Plata, llevamos tecnología a toda la región: <strong>Necochea, Miramar, Chapadmalal, Batán, Balcarce, Sierra de los Padres, Coronel Vidal, Vivoratá y Villa Gesell</strong>.
      </p>
      <div class="w-full h-80 bg-zinc-800 rounded-2xl overflow-hidden border border-zinc-700 grayscale hover:grayscale-0 transition-all duration-500">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d100570.67246581413!2d-57.63701620953935!3d-38.00537021571439!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9584d94d19d34ea3%3A0x310141349a1d5272!2sMar%20del%20Plata%2C%20Provincia%20de%20Buenos%20Aires!5e0!3m2!1ses-419!2sar!4v1700000000000!5m2!1ses-419!2sar" 
          width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </section>

    <!-- SCRIPT DE PAGINACIÓN OPTIMIZADO PARA EVITAR FLICKER EN SCROLL MÓVIL -->
    <script>
      // @ts-nocheck
      const itemsCarrusel = document.querySelectorAll('.item-carrusel');
      const btnPrev = document.getElementById('btn-prev');
      const btnNext = document.getElementById('btn-next');
      const indicador = document.getElementById('indicador-pagina');
      let paginaActual = 0;

      function renderizarCarrusel() {
        const itemsPorPagina = window.innerWidth < 768 ? 2 : 3; 
        const totalPaginas = Math.ceil(itemsCarrusel.length / itemsPorPagina);

        if (paginaActual >= totalPaginas) paginaActual = totalPaginas - 1;
        if (paginaActual < 0) paginaActual = 0;

        const indiceInicio = paginaActual * itemsPorPagina;
        const indiceFin = indiceInicio + itemsPorPagina;

        if (indicador) {
          indicador.textContent = `${paginaActual + 1} / ${totalPaginas}`;
        }

        itemsCarrusel.forEach((item, index) => {
          const video = item.querySelector('video');

          if (index >= indiceInicio && index < indiceFin) {
            if (!item.classList.contains('flex')) {
              item.classList.remove('hidden');
              item.classList.add('flex', 'anim-fade');
            }
            if (video && video.paused) {
              video.play().catch(() => {});
            }
          } else {
            if (!item.classList.contains('hidden')) {
              item.classList.remove('flex', 'anim-fade');
              item.classList.add('hidden');
            }
            if (video && !video.paused) {
              video.pause();
            }
          }
        });
      }

      if (btnNext) {
        btnNext.addEventListener('click', () => {
          const itemsPorPagina = window.innerWidth < 768 ? 2 : 3;
          const totalPaginas = Math.ceil(itemsCarrusel.length / itemsPorPagina);
          paginaActual = (paginaActual + 1) % totalPaginas;
          renderizarCarrusel();
        });
      }

      if (btnPrev) {
        btnPrev.addEventListener('click', () => {
          const itemsPorPagina = window.innerWidth < 768 ? 2 : 3;
          const totalPaginas = Math.ceil(itemsCarrusel.length / itemsPorPagina);
          paginaActual = (paginaActual - 1 + totalPaginas) % totalPaginas;
          renderizarCarrusel();
        });
      }

      // CORRECCIÓN: Solo re-renderizar si cambia el breakpoint de pantalla real (evita el parpadeo por scroll móvil)
      let anchoVentanaAnterior = window.innerWidth;
      window.addEventListener('resize', () => {
        const anchoActual = window.innerWidth;
        if ((anchoVentanaAnterior < 768 && anchoActual >= 768) || (anchoVentanaAnterior >= 768 && anchoActual < 768)) {
          anchoVentanaAnterior = anchoActual;
          renderizarCarrusel();
        }
      });

      document.addEventListener('DOMContentLoaded', () => {
        renderizarCarrusel();
      });

      renderizarCarrusel();

      const btnMenu = document.getElementById('btn-menu');
      const menuMovil = document.getElementById('menu-movil');
      const enlacesMoviles = document.querySelectorAll('.enlace-movil');

      if (btnMenu && menuMovil) {
        btnMenu.addEventListener('click', () => {
          menuMovil.classList.toggle('hidden');
          menuMovil.classList.toggle('flex');
        });
      }

      enlacesMoviles.forEach(enlace => {
        enlace.addEventListener('click', () => {
          if (menuMovil) {
            menuMovil.classList.add('hidden');
            menuMovil.classList.remove('flex');
          }
        });
      });

      const enlacesNav = document.querySelectorAll('.enlace-nav');
      
      function easeOutQuart(t, b, c, d) {
        t /= d;
        t--;
        return -c * (t*t*t*t - 1) + b;
      }

      function smoothScroll(event) {
        event.preventDefault();
        const targetId = this.getAttribute('href').substring(1);
        const targetSection = document.getElementById(targetId);
        if (!targetSection) return;

        const headerOffset = 80;
        const targetPosition = targetSection.getBoundingClientRect().top;
        const startPosition = window.pageYOffset;
        const distance = targetPosition - headerOffset;
        const duration = 1200; 
        let start = null;

        function step(timestamp) {
          if (!start) start = timestamp;
          const progress = timestamp - start;
          const run = easeOutQuart(progress, startPosition, distance, duration);
          window.scrollTo(0, run);
          if (progress < duration) {
            window.requestAnimationFrame(step);
          } else {
            window.scrollTo(0, startPosition + distance);
          }
        }
        window.requestAnimationFrame(step);
      }

      enlacesNav.forEach(enlace => {
        enlace.addEventListener('click', smoothScroll);
      });
    </script>
  </body>
</html>